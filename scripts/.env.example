# Copia este fichero a .env (está en .gitignore) y ajústalo. Las rutas son relativas
# a la carpeta desde la que lanzas el script (normalmente scripts/).
GCHAT_CLIENT_SECRET=./client_secret_XXXX.apps.googleusercontent.com.json
GCHAT_TOKEN_FILE=./token.json
GCHAT_OUT_DIR=./gchat-backup
GCHAT_DRY_RUN=true
# GCHAT_SPACE_TYPES=SPACE,GROUP_CHAT,DIRECT_MESSAGE
# GCHAT_SPACE_FILTER=
# GCHAT_SINCE=2024-01-01
# GCHAT_DOWNLOAD_ATTACHMENTS=true
# GCHAT_MIN_FREE_GB=20
# GCHAT_WORKERS=4
