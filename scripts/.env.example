# Optional: nothing needs configuring. To change a default, copy this file to .env
# (it is in .gitignore). Relative paths are resolved from this folder (scripts/).

# Chats backed up at the same time (1-16), 4 by default.
# GCHAT_WORKERS=4

# Where the copy is saved. By default, scripts/gchat-backup/. It can be a Dropbox folder.
# GCHAT_OUT_DIR=/Users/your-user/Dropbox/gchat-backup

# Where each chat goes inside <user>/, '/' between folder levels. {name} chat name,
# {last} / {first} date of the last / first message ({last:%Y%m%d}), {type}, {id}.
# GCHAT_FOLDER_TEMPLATE={last:%Y}/{last:%m}/{name}

# Only if the client_secret is not in scripts/ or there is more than one:
# GCHAT_CLIENT_SECRET=./client_secret_XXXX.apps.googleusercontent.com.json

# Where the sign-in token is kept. By default, scripts/token.json.
# GCHAT_TOKEN_FILE=token.json

# Other filters, rarely needed:
# GCHAT_SPACE_TYPES=SPACE,GROUP_CHAT,DIRECT_MESSAGE
# GCHAT_SPACE_FILTER=
# GCHAT_SINCE=2024-01-01
# GCHAT_DOWNLOAD_ATTACHMENTS=true
# GCHAT_MIN_FREE_GB=20
# GCHAT_DRY_RUN=false      # same as --preview
