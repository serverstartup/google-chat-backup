# Opcional. Copia este fichero a .env (está en .gitignore) y ajústalo; sin .env valen los
# valores por defecto. Las rutas relativas cuentan desde esta carpeta (scripts/).

# Chats que se exportan a la vez (1-16). 4 va bien sin acercarse a las cuotas de Google.
GCHAT_WORKERS=4

# Dónde se guarda la copia. Por defecto, scripts/gchat-backup/. Puede ser una carpeta de Dropbox.
# GCHAT_OUT_DIR=/Users/tu-usuario/Dropbox/gchat-backup

# Solo si el client_secret no está en scripts/ o hay más de uno:
# GCHAT_CLIENT_SECRET=./client_secret_XXXX.apps.googleusercontent.com.json

# Otros filtros, rara vez necesarios:
# GCHAT_SPACE_TYPES=SPACE,GROUP_CHAT,DIRECT_MESSAGE
# GCHAT_SPACE_FILTER=
# GCHAT_SINCE=2024-01-01
# GCHAT_DOWNLOAD_ATTACHMENTS=true
# GCHAT_MIN_FREE_GB=20
