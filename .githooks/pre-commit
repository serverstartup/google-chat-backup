#!/usr/bin/env bash
#
# Quality gate. Aborts the commit if the stage contains:
#   1) credentials or Terraform state (by file name), or
#   2) any term from a LOCAL denylist (denylist.txt, gitignored).
#
# The denylist lives only on your machine, so the forbidden term (e.g. the
# client's name) never appears in a versioned file — not even in this hook.
# The hook does NOT print the term that matched, only the file, so it is not
# dumped into the terminal logs.
#
# Skip it once (at your own risk): git commit --no-verify
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
fail=0

staged="$(git diff --cached --name-only --diff-filter=ACMR)"  # R: a renamed file can carry new content
[ -z "$staged" ] && exit 0

# 1) Credentials / state by file name
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in
    terraform/bootstrap/resources/env/*.tfvars.json) ;;  # public settings, committed on purpose
    *client_secret*|*token.json|*.tfvars|*.tfvars.json|*.tfstate|*.tfstate.*)
      echo "pre-commit: '$f' must not be committed (credential or Terraform state)."
      fail=1 ;;
  esac
done <<EOF
$staged
EOF

# 2) Content denylist (local, gitignored). One regular expression per line.
deny="$root/denylist.txt"
if [ -f "$deny" ]; then
  while IFS= read -r term || [ -n "$term" ]; do
    case "$term" in ''|\#*) continue ;; esac
    while IFS= read -r f; do
      [ -z "$f" ] && continue
      # no grep -q: it exits on the first match, git show dies of SIGPIPE on a large file,
      # and pipefail turns the match into a miss
      if git show ":$f" 2>/dev/null | grep -iE -- "$term" >/dev/null; then
        echo "pre-commit: '$f' contains a term blocked by denylist.txt."
        fail=1
      fi
    done <<EOF2
$staged
EOF2
  done < "$deny"
fi

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "Commit aborted by the quality gate. Fix the files and try again."
  exit 1
fi
exit 0
